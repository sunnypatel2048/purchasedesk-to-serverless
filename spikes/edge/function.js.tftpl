// Viewer-request router (cloudfront-js-2.0). Rendered by Terraform: kvs_id is filled in at apply.
// Sends each request to the "legacy" or "new" origin from a per-route weight in the KeyValueStore.
import cf from 'cloudfront';

const kvs = cf.kvs('${kvs_id}');

async function getOr(key, fallback) {
  try {
    return await kvs.get(key);
  } catch (e) {
    return fallback; // a missing key throws
  }
}

// Small, stable hash so one client always lands in the same bucket (0-99). Products stay near 2^48, far
// below 2^53, so plain number arithmetic is exact; the final mix stops similar IDs (c-1, c-2) landing in neighbouring buckets.
var P = 16777213; // prime below 2^24
function bucket(id) {
  var h = 2166136;
  for (var i = 0; i < id.length; i++) {
    h = (h * 16777199 + id.charCodeAt(i)) % P;
  }
  h = h ^ (h >>> 13);
  h = (h * 40503) % P;
  h = h ^ (h >>> 11);
  return h % 100;
}

async function handler(event) {
  var request = event.request;
  var headers = request.headers;

  // Test override: forces a side when the caller also knows the secret token.
  var force = headers['x-force-origin'] ? headers['x-force-origin'].value : '';
  if (force === 'legacy' || force === 'new') {
    var token = await getOr('override-token', '');
    if (token !== '' && headers['x-override-token'] && headers['x-override-token'].value === token) {
      cf.selectRequestOriginById(force);
      return request;
    }
  }

  // The runtime rejects await inside call arguments ("await in arguments not supported").
  var raw = await getOr('weight:' + request.method + ':' + request.uri, '0');
  var weight = parseInt(raw, 10) || 0;
  var clientId = headers['x-client-id'] ? headers['x-client-id'].value : event.viewer.ip;

  cf.selectRequestOriginById(bucket(clientId) < weight ? 'new' : 'legacy');
  return request;
}
