<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the legacy API. They host it in memory with Web API's HttpServer (no IIS) and call real SQL Server,
    so they run only on Windows (GitHub's windows-2022 runners). On a Mac this project compiles but cannot run.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PurchaseDesk.Web\PurchaseDesk.Web.csproj" />
    <ProjectReference Include="..\PurchaseDesk.Export\PurchaseDesk.Export.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />  <!-- TextFieldParser, to read the CSV back -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
