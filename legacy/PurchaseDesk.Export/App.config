<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Local placeholders only; the server's real values are written at boot. Never commit real values. -->
  <connectionStrings>
    <add name="PurchaseDesk" connectionString="Server=localhost;Database=PurchaseDesk;Integrated Security=true" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="ExportFolder" value="D:\Exports\PurchaseDesk" />
    <add key="LogFolder" value="D:\Logs\PurchaseDesk" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
